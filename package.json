{
  "name": "offscript-monorepo",
  "private": true,
  "description": "Did your coding agent do what you asked, only what you asked, and did it tell you the truth?",
  "license": "Apache-2.0",
  "author": "Sujal (https://github.com/SujalKrG)",
  "repository": "github:SujalKrG/offscript",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "offscript": "bun packages/cli/src/main.ts",
    "spike": "bun packages/core/src/spike.ts",
    "spike:score": "bun packages/core/src/score-labels.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/coverage-gate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check": "biome ci . && tsc -p tsconfig.json --noEmit && bun run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
